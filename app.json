{
  "expo": {
    "name": "SuriOS",
    "slug": "surios-ai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "surios",
    "userInterfaceStyle": "light",
    "primaryColor": "#C93D00",
    "ios": {},
    "android": {
      "package": "site.surios.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#C93D00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose evidence for your public infrastructure report.",
          "cameraPermission": "Take a photo of the infrastructure issue you are reporting.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to place a report pin. You can also select it manually."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2476c458-db69-4066-a4cf-95637a4c005e"
      }
    },
    "owner": "auvy"
  }
}
