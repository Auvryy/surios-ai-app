# Public origin of the existing SuriOS website/backend; do not append /api.
# Shared Azure backend, used by both the website and mobile app.
EXPO_PUBLIC_API_BASE_URL=https://surios.site
# Optional local backend for development:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5185
# For a phone accessing a local backend, use your PC's reachable LAN IP.
# HTTP is allowed in development only; release builds require HTTPS.
# Never put Gemini keys, database URLs, passwords, or session secrets here.
